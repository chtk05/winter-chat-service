# WinterChat — required environment variables (T-001)
#
# Every variable below traces to a recorded decision. Nothing is listed here
# speculatively (CLAUDE.md §3.2). The repo is PUBLIC (D-001) — no real value
# belongs in this file or anywhere else in source.
#
# D-025 split the app in two, so the variables are grouped by which one reads
# them. Copy the relevant block into apps/api/.env and apps/web/.env.local.

# ─── apps/api ────────────────────────────────────────────────────────────────

# D-001 — PostgreSQL (Supabase). Used by Prisma.
DATABASE_URL=postgresql://user:password@host:5432/winterchat

# D-002, D-009 — the ONE shared workspace access code. Not per-user, does not
# expire, is not single-use (D-017). Rotating it means changing this value.
ACCESS_CODE=

# D-008 — secret used to sign the session cookie. Must be distinct from
# ACCESS_CODE. Rotating it invalidates every live session at once.
SESSION_SECRET=

# D-012 — LINE channel secret, for verifying the X-Line-Signature HMAC on every
# inbound webhook request.
LINE_CHANNEL_SECRET=

# D-003, D-006 — LINE channel access token, for the Reply and Push APIs.
LINE_CHANNEL_ACCESS_TOKEN=

# D-029 — the exact origins allowed to send credentialed cross-origin requests.
# Comma-separated; never a wildcard, which is invalid alongside
# Access-Control-Allow-Credentials and would expose the session to any site.
WEB_ORIGIN=http://localhost:3000

# ─── apps/web ────────────────────────────────────────────────────────────────

# D-025 — apps/api is a second origin. This is the single place the frontend
# names it; see src/lib/api/client.ts.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# D-005 — Supabase Realtime browser subscription. The anon key is public by
# design; Row Level Security is what constrains it (T-016).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Not environment variables ───────────────────────────────────────────────
#
# D-014 fixes Asia/Bangkok as the dashboard's calendar zone and requires it be
# configurable "in one place, not scattered through queries". That is a single
# source-level constant, not a deployment knob, so it is deliberately absent here.
