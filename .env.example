# WinterChat — required environment variables (T-001)
#
# Every variable below traces to a recorded decision. Nothing is listed here
# speculatively (CLAUDE.md §3.2). The repo is PUBLIC (D-001) — no real value
# belongs in this file or anywhere else in source.
#
# D-025 split the app in two, so the variables are grouped by which one reads
# them. Copy the relevant block into apps/api/.env and apps/web/.env.local.

# ─── apps/api ────────────────────────────────────────────────────────────────

# D-001 — PostgreSQL (Supabase), the pooled connection. Used by Prisma at runtime.
DATABASE_URL=postgresql://user:password@host:6543/winterchat?pgbouncer=true

# D-064's vercel-build fix: the SESSION-mode / direct connection, used ONLY for
# `prisma migrate deploy` (the pooled connection above does not support the
# advisory locks migrations need, and hangs rather than erroring).
DIRECT_URL=postgresql://user:password@host:5432/winterchat

# D-058 — Supabase Storage, for LINE image messages (both directions). SUPABASE_URL
# is the project's REST URL; SUPABASE_SERVICE_ROLE_KEY is server-side only and must
# never be exposed to the browser (unlike the NEXT_PUBLIC_ Supabase pair below).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# D-038 — the ONE shared JOIN code, checked AFTER LINE Login (D-036). Not
# per-admin, does not expire, is not single-use. Explicitly provisional.
ACCESS_CODE=

# D-041 — verifies the short-lived service token apps/web mints on each proxied
# call. Must be distinct from ACCESS_CODE (D-008).
#
# D-039: the SAME value must be set in BOTH Vercel projects. Rotating it
# invalidates every session in both at once, and the two drifting out of sync is
# the practical failure mode of this design.
SESSION_SECRET=

# D-012 — LINE channel secret, for verifying the X-Line-Signature HMAC on every
# inbound webhook request.
LINE_CHANNEL_SECRET=

# D-003, D-006 — LINE channel access token, for the Reply and Push APIs.
LINE_CHANNEL_ACCESS_TOKEN=

# WEB_ORIGIN was removed by D-040 along with cors.ts: no browser reaches
# apps/api, so there is no origin to allow-list.

# ─── apps/web ────────────────────────────────────────────────────────────────

# D-037, D-043 — Auth.js v5 (`next-auth@5.0.0-beta.32`, pinned exactly).
#
# These names are the ones the INSTALLED package actually reads, checked in
# node_modules/@auth/core/lib/utils/env.js rather than assumed (D-033):
#   AUTH_SECRET                    — env.js:30
#   AUTH_<PROVIDER>_ID / _SECRET   — env.js:47-49, uppercased from the provider id,
#                                    so the `line` provider reads AUTH_LINE_*.
#
# AUTH_SECRET encrypts Auth.js's own session cookie and is SEPARATE from
# SESSION_SECRET, which signs the service token apps/api verifies (D-041).
AUTH_SECRET=

# D-035 — LINE **Login** channel credentials. A LINE Login channel is a DIFFERENT
# channel type from the Messaging API channel above, with its own credentials.
# LINE_CHANNEL_SECRET / LINE_CHANNEL_ACCESS_TOKEN must NOT be reused here.
# Callback URL to register: http://localhost:3000/api/auth/callback/line
AUTH_LINE_ID=
AUTH_LINE_SECRET=

# D-039, D-041 — the SAME value as apps/api's SESSION_SECRET. apps/web mints the
# service token; apps/api verifies it. The two drifting apart is the practical
# failure mode of this design.
SESSION_SECRET=

# D-025, D-040 — apps/api's origin, read SERVER-SIDE ONLY by the /gateway/*
# proxy. Deliberately not NEXT_PUBLIC_: the browser never contacts apps/api.
# Consumed by T-027, which is not built yet.
API_ORIGIN=http://localhost:3001

# D-005 — Supabase Realtime browser subscription. The anon key is public by
# design; Row Level Security is what constrains it (T-016).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Not environment variables ───────────────────────────────────────────────
#
# D-014 fixes Asia/Bangkok as the dashboard's calendar zone and requires it be
# configurable "in one place, not scattered through queries". That is a single
# source-level constant, not a deployment knob, so it is deliberately absent here.
